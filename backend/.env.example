# RuView Fall Detection Backend Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
API_PREFIX=/api

# Security
API_KEY=
CORS_ORIGINS=["*"]

# Database (Default: local SQLite; for PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/ruview)
DATABASE_URL=sqlite+aiosqlite:///./fall_detection.db

# Direct UDP Ingestion (Receives CSI & Vitals from ESP32-S3)
UDP_ENABLED=true
UDP_BIND_HOST=0.0.0.0
UDP_PORT=5005

# Optional RuView Sensing Server Upstream Bridge
# Leave empty if ingesting directly from ESP32 over UDP
RUVIEW_WS_URL=
RUVIEW_HTTP_URL=
RUVIEW_API_TOKEN=

# Node Tracking & Fall Cooldown
NODE_OFFLINE_TIMEOUT_S=5.0
FALL_COOLDOWN_MS=5000
FALL_CONSEC_MIN=3
RAW_CSI_RECORDING=false
